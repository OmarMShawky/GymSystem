@model CreateMemberViewModel
@using System
@using System.Linq

<div class="container">
    <main role="main" class="pb-3">

        <header class="mb-4">
            <h3 class="text-primary-color">Add Member</h3>
        </header>

        <form method="post" asp-action="Create" asp-controller="Members" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <ul class="nav nav-tabs mb-4" id="addMemberTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="member-tab" data-bs-toggle="tab" data-bs-target="#member-info"
                            type="button" role="tab" aria-controls="member-info" aria-selected="true">
                        Member Info
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="health-tab" data-bs-toggle="tab" data-bs-target="#health-info"
                            type="button" role="tab" aria-controls="health-info" aria-selected="false">
                        Health Data
                    </button>
                </li>
            </ul>

            <div class="tab-content">

                <div class="tab-pane fade show active" id="member-info" role="tabpanel" aria-labelledby="member-tab">
                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">Personal Information</h5>
                        <hr class="mt-2">
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Name"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Email"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Phone"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="DateOfBirth"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Gender"></label>
                            <select asp-for="Gender" class="form-select" asp-items="@Html.GetEnumSelectList<Gender>()">
                                <option value="">-- Select Gender --</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="section-header mb-3 mt-4">
                        <h5 class="text-primary fw-bold">Address Information</h5>
                        <hr class="mt-2">
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="BuildingNumber"></label>
                            <input asp-for="BuildingNumber" class="form-control" type="number" />
                            <span asp-validation-for="BuildingNumber" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Street"></label>
                            <input asp-for="Street" class="form-control" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="City"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="section-header mb-3 mt-4">
                        <h5 class="text-primary fw-bold">Photo</h5>
                        <hr class="mt-2">
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="Photo"></label>
                            <input asp-for="Photo" id="photoInput" type="file" class="form-control"
                                   accept=".jpg,.jpeg,.png" />
                            <span asp-validation-for="Photo" class="text-danger"></span>
                            <div class="form-text">
                                @FileSettings.AllowedExtensionsDisplay &mdash; max @FileSettings.MaxFileSizeDisplay.
                            </div>
                        </div>
                        <div class="col-12 col-md-6 d-flex align-items-center">
                            <img id="photoPreview" src="#" alt="Photo preview" style="display:none; max-width:150px; max-height:150px;" />
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="health-info" role="tabpanel" aria-labelledby="health-tab">
                    <div class="section-header mb-3">
                        <h5 class="text-primary fw-bold">Health Data</h5>
                        <hr class="mt-2">
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="HealthRecord.Height"></label>
                            <input asp-for="HealthRecord.Height" class="form-control" type="number" step="0.1" />
                            <span asp-validation-for="HealthRecord.Height" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="HealthRecord.Weight"></label>
                            <input asp-for="HealthRecord.Weight" class="form-control" type="number" step="0.1" />
                            <span asp-validation-for="HealthRecord.Weight" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="HealthRecord.BloodType"></label>
                            <select asp-for="HealthRecord.BloodType" class="form-select" asp-items="@Html.GetEnumSelectList<BloodType>()">
                                <option value="">Select</option>
                            </select>
                            <span asp-validation-for="HealthRecord.BloodType" class="text-danger"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label" asp-for="HealthRecord.Notes"></label>
                            <input asp-for="HealthRecord.Notes" class="form-control" />
                            <span asp-validation-for="HealthRecord.Notes" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="d-flex justify-content-end gap-3 mt-4">
                <a asp-controller="Members" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-2"></i> Back to List
                </a>

                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-plus-circle me-2"></i> Add
                </button>
            </footer>
        </form>

    </main>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            const photoInput = document.getElementById('photoInput');
            const photoPreview = document.getElementById('photoPreview');

            if (!photoInput || !photoPreview) return;

            photoInput.addEventListener('change', function (e) {
                const file = e.target.files && e.target.files[0];
                if (!file) {
                    photoPreview.style.display = 'none';
                    photoPreview.src = '#';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function (ev) {
                    photoPreview.src = ev.target.result;
                    photoPreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
