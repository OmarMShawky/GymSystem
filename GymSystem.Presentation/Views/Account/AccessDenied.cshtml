@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - Power Fitness</title>

    <script>
        (function () {
            try {
                var t = localStorage.getItem('pf-theme');
                if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
                document.documentElement.setAttribute('data-bs-theme', t);
            } catch (e) { }
        })();
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root, [data-bs-theme="light"] {
            --page-bg: #f4f6fb;
            --panel: #ffffff;
            --line: #e6e9f2;
            --ink: #14162b;
            --muted: #666;
            --brand: #0033cc;
            --code-bg: #f0f0f0;
        }

        [data-bs-theme="dark"] {
            --page-bg: #101026;
            --panel: #1b1b3d;
            --line: #2f2f5c;
            --ink: #e8e9f5;
            --muted: #a2a5c4;
            --brand: #8b93ff;
            --code-bg: #22224a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--page-bg);
            color: var(--ink);
            min-height: 100vh;
            display: flex;
            align-items: center;
            transition: background-color .25s ease, color .25s ease;
        }

        .theme-toggle-floating {
            position: fixed;
            top: 20px;
            right: 20px;
            width: 44px;
            height: 44px;
            border-radius: 50%;
            border: 1px solid var(--line);
            background: var(--panel);
            color: var(--ink);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            cursor: pointer;
            transition: transform .2s ease;
        }

            .theme-toggle-floating:hover {
                transform: rotate(-12deg) scale(1.06);
            }

            .theme-toggle-floating .icon-dark {
                display: none;
            }

        [data-bs-theme="dark"] .theme-toggle-floating .icon-dark {
            display: inline;
        }

        [data-bs-theme="dark"] .theme-toggle-floating .icon-light {
            display: none;
        }

        /* Main Container */
        .container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px;
        }

        .access-denied-wrapper {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 60px;
            align-items: center;
            background: var(--panel);
            padding: 60px;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        }

        /* Left Content */
        .content {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .error-icon {
            font-size: 64px;
            color: #ff4757;
        }

        h1 {
            font-size: 48px;
            color: var(--ink);
            font-weight: bold;
            line-height: 1.2;
        }

        .error-highlight {
            color: var(--brand);
        }

        .error-message {
            font-size: 16px;
            color: var(--muted);
            line-height: 1.6;
        }

        .error-code {
            background-color: var(--code-bg);
            padding: 12px 16px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            color: var(--ink);
            margin: 10px 0;
        }

        /* Buttons */
        .button-group {
            display: flex;
            gap: 15px;
            margin-top: 20px;
        }

        .btn {
            padding: 12px 28px;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            text-decoration: none;
            display: inline-block;
            text-align: center;
        }

        .btn-primary {
            background-color: var(--brand);
            color: white;
        }

            .btn-primary:hover {
                background-color: #0028a3;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(0, 51, 204, 0.3);
            }

        .btn-secondary {
            background-color: transparent;
            color: var(--brand);
            border: 2px solid var(--brand);
        }

            .btn-secondary:hover {
                background-color: color-mix(in srgb, var(--brand) 12%, transparent);
            }

        /* Right Image */
        .image-section {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .lock-icon {
            font-size: 120px;
            opacity: 0.8;
        }

        @@media (max-width: 768px) {
            .container {
                padding: 20px;
            }

            .access-denied-wrapper {
                grid-template-columns: 1fr;
                gap: 30px;
                padding: 30px;
            }

            h1 {
                font-size: 36px;
            }

            .button-group {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .lock-icon {
                font-size: 80px;
            }
        }
    </style>
</head>
<body>
    <button type="button" class="theme-toggle-floating" data-theme-toggle aria-pressed="false" title="Switch to dark mode">
        <i class="bi bi-moon-stars-fill icon-light" aria-hidden="true"></i>
        <i class="bi bi-sun-fill icon-dark" aria-hidden="true"></i>
    </button>

    <div class="container">
        <div class="access-denied-wrapper">

            <div class="content">
                <div class="error-icon">🚫</div>
                <h1>
                    Access <span class="error-highlight">Denied</span>
                </h1>
                <p class="error-message">
                    We're sorry, but you don't have permission to access this resource. Your current user role or membership status doesn't grant you access to this section.
                </p>
                <div class="error-code">
                    Error Code: 403 - Forbidden Access
                </div>
                <p class="error-message">
                    If you believe this is an error or need elevated permissions, please contact the system administrator or your membership manager for assistance.
                </p>
                <div class="button-group">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Return to Home</a>
                    <a asp-action="Login" asp-controller="Account" class="btn btn-secondary">Sign in as another user</a>
                </div>
            </div>

            <div class="image-section">
                <div class="lock-icon">🔒</div>
            </div>
        </div>
    </div>
    <script src="~/js/theme-toggle.js" asp-append-version="true"></script>
</body>
</html>
