@using GymSystem.DataAccess.Data.Seed
@using Microsoft.AspNetCore.Identity
@using GymSystem.DataAccess.Entities.Identity
@inject SignInManager<ApplicationUser> SignInManager

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isSuperAdmin = User.IsInRole(IdentitySeeder.SuperAdminRole);
}

<header>

    <nav class="navbar navbar-expand-lg bg-white my-3">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.jpg" alt="" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">

                @if (isSignedIn)
                {
                    <ul class="navbar-nav m-auto mb-2 mb-lg-0 mt-3 mt-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (isSuperAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Members" asp-action="Index">Members</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Trainers" asp-action="Index">Trainers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Sessions" asp-action="Index">Sessions</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Plans" asp-action="Index">Plans</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Memberships" asp-action="Index">Memberships</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative" asp-controller="Bookings" asp-action="Index">Sessions Schedule</a>
                        </li>
                        <li class="nav-item">
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit"
                                        class="btn btn-link nav-link px-3 py-2 mx-2 fw-bolder fs-5 text-black-alternative">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>

                    <button type="button" class="theme-toggle ms-lg-2 mb-3 mb-lg-0"
                            data-theme-toggle aria-pressed="false" title="Switch to dark mode">
                        <i class="bi bi-moon-stars-fill icon-light" aria-hidden="true"></i>
                        <i class="bi bi-sun-fill icon-dark" aria-hidden="true"></i>
                        <span class="visually-hidden">Toggle dark mode</span>
                    </button>
                }
                else
                {
                    <button type="button" class="theme-toggle ms-auto"
                            data-theme-toggle aria-pressed="false" title="Switch to dark mode">
                        <i class="bi bi-moon-stars-fill icon-light" aria-hidden="true"></i>
                        <i class="bi bi-sun-fill icon-dark" aria-hidden="true"></i>
                        <span class="visually-hidden">Toggle dark mode</span>
                    </button>
                }
            </div>
        </div>
    </nav>
</header>
