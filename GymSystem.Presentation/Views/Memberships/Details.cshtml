@model MembershipDetailsViewModel
@{
    ViewBag.Title = "Membership Details";
    var headerClass = Model.IsActive ? "bg-primary-color" : "bg-secondary";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0">
            <div class="card-header text-white text-center py-5 @headerClass">
                <i class="bi bi-card-checklist display-4 mb-3"></i>
                <h2 class="mb-2">@Model.PlanName</h2>
                <span class="badge bg-light text-dark rounded-pill px-3 py-2">@Model.Status</span>
            </div>

            <div class="card-body p-4">
                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-person-fill text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Member</h6>
                            <p class="mb-0 fw-bold">@Model.MemberName</p>
                            <p class="mb-0 text-muted small">@Model.MemberEmail &middot; @Model.MemberPhone</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-start">
                        <div class="icon-box me-3">
                            <i class="bi bi-file-text text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Plan</h6>
                            <p class="mb-0 fw-bold">@Model.PlanName</p>
                            <p class="mb-0 text-muted small">@Model.PlanDescription</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-cash-coin text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Price</h6>
                            <p class="mb-0 fw-bold">@Model.Price.ToString("0") EGP <span class="text-muted fw-normal">/ @Model.DurationDays day(s)</span></p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-play-circle text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Start Date</h6>
                            <p class="mb-0 fw-bold">@Model.StartDate</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-stop-circle text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">End Date</h6>
                            <p class="mb-0 fw-bold">@Model.EndDate</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-hourglass-split text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Remaining</h6>
                            <p class="mb-0 fw-bold">
                                @if (Model.IsActive)
                                {
                                    @($"{Model.DaysRemaining} day(s) left")
                                }
                                else
                                {
                                    <span class="text-secondary">Expired</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <div class="d-flex justify-content-between gap-2">
                    <a asp-controller="Memberships" asp-action="Index" class="btn btn-outline flex-fill">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
