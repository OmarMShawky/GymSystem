@model TrainerDetailsViewModel
@{
    ViewBag.Title = "Trainer Details";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-primary-color text-white text-center py-5">
                <i class="bi bi-person-badge display-4 mb-3"></i>
                <h2 class="mb-2">@Model.Name</h2>
                <span class="badge bg-light text-primary-color rounded-pill px-3 py-2">@Model.Specialization</span>
            </div>

            <div class="card-body p-4">
                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-envelope text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Email</h6>
                            <p class="mb-0 fw-bold">@Model.Email</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-telephone text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Phone</h6>
                            <p class="mb-0 fw-bold">@Model.Phone</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-gender-ambiguous text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Gender</h6>
                            <p class="mb-0 fw-bold">@Model.Gender</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-cake2 text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Date Of Birth</h6>
                            <p class="mb-0 fw-bold">@Model.DateOfBirth</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-house text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Address</h6>
                            <p class="mb-0 fw-bold">@Model.BuildingNumber · @Model.Street · @Model.City</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <div class="d-flex justify-content-between gap-2">
                    <a asp-controller="Trainers" asp-action="Index" class="btn btn-outline flex-fill">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
