@model IEnumerable<TrainerViewModel>
@{
    ViewBag.Title = "Trainers";
}

<header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
    <div>
        <h2 class="text-primary-color mb-0">Trainers</h2>
        <p class="text-muted mb-0">Manage your professional instructors</p>
    </div>
    <a asp-controller="Trainers" asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-3 py-3"> + Add Trainer </a>
</header>

@if (ViewBag.Message != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @ViewBag.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Any())
{
    <div class="table-responsive" style="overflow: visible;">
        <table class="table table-borderless align-middle">
            <thead>
                <tr>
                    <th><span>Name</span></th>
                    <th><span>Email</span></th>
                    <th><span>Phone</span></th>
                    <th><span>Specialization</span></th>
                    <th><span>Action</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trainer in Model)
                {
                    <tr>
                        <td><span>@trainer.Name</span></td>
                        <td><span>@trainer.Email</span></td>
                        <td><span>@trainer.Phone</span></td>
                        <td>
                            <span class="badge bg-primary rounded-pill px-3 py-2">@trainer.Specialization</span>
                        </td>
                        <td class="action position-relative">
                            <div class="dropdown">
                                <button class="btn btn-link p-0 border-0" type="button"
                                        id="dropdownMenuButton-@trainer.Id" data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <img src="~/images/action dots.jpg" alt="action icon" />
                                </button>
                                <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton-@trainer.Id">
                                    <li>
                                        <a asp-controller="Trainers" asp-action="Details" asp-route-id="@trainer.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">
                                            <img src="~/images/info 1.jpg" alt="info icon"
                                                 style="width: 20px; height: 20px;" />
                                            <span>View Details</span>
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a asp-controller="Trainers" asp-action="Edit" asp-route-id="@trainer.Id"
                                           class="dropdown-item d-flex align-items-center gap-3">
                                            <img src="~/images/edit.jpg" alt="edit icon"
                                                 style="width: 20px; height: 20px;" />
                                            <span>Edit Trainer Data</span>
                                        </a>
                                    </li>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <a asp-controller="Trainers" asp-action="Delete" asp-route-id="@trainer.Id"
                                           class="dropdown-item d-flex align-items-center gap-3 text-danger">
                                            <img src="~/images/x-circle 1.jpg" alt="delete icon"
                                                 style="width: 20px; height: 20px;" />
                                            <span>Delete</span>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <i class="bi bi-person-badge display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">No Trainers Available</h4>
        <p class="text-muted">Add your first trainer to get started</p>
    </div>
}
