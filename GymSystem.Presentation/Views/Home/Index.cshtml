@using GymSystem.DataAccess.Data.Seed
@model DashboardViewModel
@{
    ViewBag.Title = "Dashboard";
    var isSuperAdmin = User.IsInRole(IdentitySeeder.SuperAdminRole);
}

<section class="dashboard mt-4 mb-5">
    <header class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h1 class="fw-bolder display-6 mb-1 text-black-alternative">
                Welcome back,
                <span class="text-primary-color">@(User.Identity?.Name?.Split('@')[0] ?? "Admin")</span>
            </h1>
            <p class="text-muted mb-0">Here's what's happening at Power Fitness right now.</p>
        </div>
        <span class="badge rounded-pill bg-light text-muted border px-3 py-2">
            <i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dddd, dd MMM yyyy")
        </span>
    </header>

    <div class="row g-3 g-lg-4">
        <div class="col-12 col-sm-6 col-xl-3">
            @if (isSuperAdmin)
            {
                <a asp-controller="Members" asp-action="Index" class="stat-card stat-card--link d-block">
                    <div class="stat-card__icon bg-primary-subtle text-primary-color">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="stat-card__value">@Model.TotalMembers</span>
                    <span class="stat-card__label">Total Members</span>
                    <span class="stat-card__hint">View all <i class="bi bi-arrow-right-short"></i></span>
                </a>
            }
            else
            {
                <div class="stat-card">
                    <div class="stat-card__icon bg-primary-subtle text-primary-color">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <span class="stat-card__value">@Model.TotalMembers</span>
                    <span class="stat-card__label">Total Members</span>
                </div>
            }
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Memberships" asp-action="Index" class="stat-card stat-card--link d-block">
                <div class="stat-card__icon bg-success-subtle text-success">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <span class="stat-card__value">@Model.ActiveMembers</span>
                <span class="stat-card__label">Active Memberships</span>
                <div class="progress stat-card__progress" role="progressbar"
                     aria-label="Active members" aria-valuenow="@Model.ActiveMemberPercentage"
                     aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar bg-success" style="width:@(Model.ActiveMemberPercentage)%"></div>
                </div>
                <span class="stat-card__hint">@Model.ActiveMemberPercentage% of members</span>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Trainers" asp-action="Index" class="stat-card stat-card--link d-block">
                <div class="stat-card__icon bg-warning-subtle text-warning-emphasis">
                    <i class="bi bi-person-badge-fill"></i>
                </div>
                <span class="stat-card__value">@Model.TotalTrainers</span>
                <span class="stat-card__label">Trainers</span>
                <span class="stat-card__hint">Manage <i class="bi bi-arrow-right-short"></i></span>
            </a>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <a asp-controller="Plans" asp-action="Index" class="stat-card stat-card--link d-block">
                <div class="stat-card__icon bg-info-subtle text-info-emphasis">
                    <i class="bi bi-card-checklist"></i>
                </div>
                <span class="stat-card__value">@Model.ActivePlans</span>
                <span class="stat-card__label">Active Plans</span>
                <span class="stat-card__hint">Manage <i class="bi bi-arrow-right-short"></i></span>
            </a>
        </div>
    </div>

    <div class="row g-3 g-lg-4 mt-1">
        <div class="col-12 col-lg-8">
            <div class="panel h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="fs-5 fw-bold mb-0 text-black-alternative">
                        <i class="bi bi-calendar-event text-primary-color me-2"></i>Sessions
                    </h2>
                    <a asp-controller="Sessions" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        View schedule
                    </a>
                </div>

                @if (Model.TotalSessions == 0)
                {
                    <div class="text-center py-4">
                        <i class="bi bi-calendar-x display-5 text-muted"></i>
                        <p class="text-muted mt-2 mb-0">No sessions scheduled yet.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3 text-center">
                        <div class="col-4">
                            <div class="mini-stat border-start border-4 border-primary">
                                <span class="mini-stat__value text-primary">@Model.UpcomingSessions</span>
                                <span class="mini-stat__label">Upcoming</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mini-stat border-start border-4 border-success">
                                <span class="mini-stat__value text-success">@Model.OngoingSessions</span>
                                <span class="mini-stat__label">Ongoing</span>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="mini-stat border-start border-4 border-secondary">
                                <span class="mini-stat__value text-secondary">@Model.CompletedSessions</span>
                                <span class="mini-stat__label">Completed</span>
                            </div>
                        </div>
                    </div>

                    <div class="progress session-split mt-4" role="progressbar" aria-label="Session status split">
                        <div class="progress-bar bg-primary"
                             style="width:@(Model.UpcomingSessions * 100 / Model.TotalSessions)%"></div>
                        <div class="progress-bar bg-success"
                             style="width:@(Model.OngoingSessions * 100 / Model.TotalSessions)%"></div>
                        <div class="progress-bar bg-secondary"
                             style="width:@(Model.CompletedSessions * 100 / Model.TotalSessions)%"></div>
                    </div>
                    <p class="text-muted small mt-2 mb-0">@Model.TotalSessions sessions in total</p>
                }
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="panel h-100">
                <h2 class="fs-5 fw-bold mb-3 text-black-alternative">
                    <i class="bi bi-lightning-charge-fill text-primary-color me-2"></i>Quick Actions
                </h2>

                <div class="d-grid gap-2">
                    @if (isSuperAdmin)
                    {
                        <a asp-controller="Members" asp-action="Create" class="btn btn-outline-secondary text-start rounded-3">
                            <i class="bi bi-person-plus me-2"></i>Add Member
                        </a>
                    }
                    <a asp-controller="Trainers" asp-action="Create" class="btn btn-outline-secondary text-start rounded-3">
                        <i class="bi bi-person-badge me-2"></i>Add Trainer
                    </a>
                    <a asp-controller="Sessions" asp-action="Create" class="btn btn-outline-secondary text-start rounded-3">
                        <i class="bi bi-calendar-plus me-2"></i>Schedule Session
                    </a>
                    <a asp-controller="Plans" asp-action="Index" class="btn btn-outline-secondary text-start rounded-3">
                        <i class="bi bi-card-checklist me-2"></i>Manage Plans
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="marquee bg-primary-color text-white fw-bolder my-5">
    <div class="marquee__track">
        <span class="marquee__group">
            <span class="marquee__item">outdoor &amp; online trainers</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
            <span class="marquee__item">personal training</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
            <span class="marquee__item">live classes</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
            <span class="marquee__item">group workouts</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
        </span>
        <span class="marquee__group" aria-hidden="true">
            <span class="marquee__item">outdoor &amp; online trainers</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
            <span class="marquee__item">personal training</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
            <span class="marquee__item">live classes</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
            <span class="marquee__item">group workouts</span>
            <img class="marquee__star" src="~/images/star.svg" alt="" />
        </span>
    </div>
</div>

<section class="about my-5 text-black-alternative">
    <div class="row g-5 justify-content-center align-items-center">
        <div class="col-12 col-lg-6">
            <div class="characters position-relative">
                <div class="image">
                    <img class="img-fluid" src="~/images/about p1.jpg" alt="Member training" />
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="title d-flex justify-content-start align-items-center gap-2">
                <img src="~/images/dumbbell.jpg" alt="" />
                <h2 class="text-primary-color fs-5 mb-0">About Us</h2>
            </div>

            <p class="fw-bolder display-6 my-3">
                EMPOWERING YOU TO ACHIEVE
                <span class="text-primary-color">YOUR FITNESS</span> GOALS
            </p>
            <p>
                We believe fitness is more than just a workout — it's a lifestyle. With
                top-of-the-line facilities, certified trainers, and a supportive community,
                we're here to inspire and guide you every step of the way.
            </p>

            <div class="row row-cols-1 row-cols-sm-2 g-4 mt-1">
                <div class="feature">
                    <div class="title d-flex gap-2 align-items-center">
                        <img src="~/images/feature icon.jpg" alt="" />
                        <h3 class="fw-bold fs-6 mb-0">Personal Training</h3>
                    </div>
                    <p class="text-muted small mb-0 mt-1">
                        One-to-one coaching built around your goals and fitness level.
                    </p>
                </div>

                <div class="feature">
                    <div class="title d-flex gap-2 align-items-center">
                        <img src="~/images/feature icon.jpg" alt="" />
                        <h3 class="fw-bold fs-6 mb-0">Group Classes</h3>
                    </div>
                    <p class="text-muted small mb-0 mt-1">
                        High-energy sessions across CrossFit, Boxing, Yoga and more.
                    </p>
                </div>

                <div class="feature">
                    <div class="title d-flex gap-2 align-items-center">
                        <img src="~/images/feature icon.jpg" alt="" />
                        <h3 class="fw-bold fs-6 mb-0">Flexible Plans</h3>
                    </div>
                    <p class="text-muted small mb-0 mt-1">
                        From a single day pass to a full year of premium access.
                    </p>
                </div>

                <div class="feature">
                    <div class="title d-flex gap-2 align-items-center">
                        <img src="~/images/feature icon.jpg" alt="" />
                        <h3 class="fw-bold fs-6 mb-0">Health Tracking</h3>
                    </div>
                    <p class="text-muted small mb-0 mt-1">
                        Height, weight and blood type kept on every member record.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="why-us my-5">
    <div class="row row-cols-1 row-cols-lg-2 g-4">
        <div class="info">
            <div class="title d-flex justify-content-start align-items-center gap-2">
                <img src="~/images/dumbbell.jpg" alt="" />
                <h2 class="text-primary-color fs-5 mb-0">Why Us</h2>
            </div>

            <p class="fw-bolder display-6 my-3">
                Elevate fitness with
                <span class="text-primary-color">the best</span> way possible
            </p>

            <ul class="list-unstyled mt-4">
                <li class="feature d-flex gap-4 align-items-start mb-4">
                    <div class="count fw-bolder fs-4">01</div>
                    <div class="text">
                        <h3 class="text-capitalize fw-bold fs-6">personalized fitness plans</h3>
                        <p class="text-muted mb-0">
                            We tailor every workout to fit your unique goals and fitness level.
                        </p>
                    </div>
                </li>

                <li class="feature d-flex gap-4 align-items-start mb-4">
                    <div class="count fw-bolder fs-4">02</div>
                    <div class="text">
                        <h3 class="text-capitalize fw-bold fs-6">certified expert trainers</h3>
                        <p class="text-muted mb-0">
                            Every trainer is matched to a specialty, so you always train with a specialist.
                        </p>
                    </div>
                </li>

                <li class="feature d-flex gap-4 align-items-start">
                    <div class="count fw-bolder fs-4">03</div>
                    <div class="text">
                        <h3 class="text-capitalize fw-bold fs-6">flexible scheduling</h3>
                        <p class="text-muted mb-0">
                            Book around your week with sessions running morning through evening.
                        </p>
                    </div>
                </li>
            </ul>
        </div>

        <div class="characters d-none d-lg-block">
            <img class="img-fluid" src="~/images/why us images.svg" alt="Trainers" />
        </div>
    </div>
</section>
