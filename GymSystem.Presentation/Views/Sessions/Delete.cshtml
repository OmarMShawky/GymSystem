@model SessionDetailsViewModel
@{
    ViewBag.Title = "Delete Session";
    var isOngoing = Model.Status == SessionStatus.Ongoing;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0">
            <div class="card-header bg-danger text-white text-center py-4">
                <i class="bi bi-exclamation-triangle display-5 mb-2"></i>
                <h3 class="mb-0">Delete Session</h3>
            </div>

            <div class="card-body p-4">
                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @ViewBag.Message
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (isOngoing)
                {
                    <div class="alert alert-warning d-flex align-items-start gap-3" role="alert">
                        <i class="bi bi-slash-circle fs-4"></i>
                        <div>
                            <strong>This session cannot be deleted.</strong>
                            <div>It is happening right now - members are training. Wait until it finishes.</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-danger d-flex align-items-start gap-3" role="alert">
                        <i class="bi bi-exclamation-octagon fs-4"></i>
                        <div>
                            <strong>This action is permanent and cannot be undone.</strong>
                            <div>
                                Deleting this session also removes
                                <strong>all @Model.BookedSlots of its bookings</strong>.
                                Booked members will lose their spot.
                            </div>
                        </div>
                    </div>
                }

                <p class="text-muted mb-3">You are about to delete the following session:</p>

                <ul class="list-group list-group-flush mb-0">
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Category</span>
                        <strong>@Model.Category</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Status</span>
                        <span class="badge rounded-pill px-3 py-2
                              @(Model.Status == SessionStatus.Upcoming ? "bg-primary"
                                : Model.Status == SessionStatus.Ongoing ? "bg-success" : "bg-secondary")">
                            @Model.Status
                        </span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Trainer</span>
                        <strong>@Model.TrainerName</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Start Time</span>
                        <strong>@Model.StartTime</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">End Time</span>
                        <strong>@Model.EndTime</strong>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span class="text-muted">Bookings</span>
                        <strong>@Model.Slots</strong>
                    </li>
                </ul>
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <div class="d-flex justify-content-end gap-3">
                    <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-2"></i>Cancel
                    </a>

                    @if (!isOngoing)
                    {
                        <form asp-controller="Sessions" asp-action="Delete" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger px-4">
                                <i class="bi bi-trash me-2"></i>Delete Permanently
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
