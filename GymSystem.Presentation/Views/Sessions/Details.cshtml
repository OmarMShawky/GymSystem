@model SessionDetailsViewModel
@{
    ViewBag.Title = "Session Details";

    var headerClass = Model.Status switch
    {
        SessionStatus.Upcoming => "bg-primary",
        SessionStatus.Ongoing => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8">
        <div class="card shadow-lg border-0">
            <div class="card-header text-white text-center py-5 @headerClass">
                <i class="bi bi-calendar-event display-4 mb-3"></i>
                <h2 class="mb-2">@Model.Category</h2>
                <span class="badge bg-light text-dark rounded-pill px-3 py-2">@Model.Status</span>
            </div>

            <div class="card-body p-4">
                <div class="detail-item mb-4">
                    <div class="d-flex align-items-start">
                        <div class="icon-box me-3">
                            <i class="bi bi-file-text text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Description</h6>
                            <p class="mb-0 fw-bold">@Model.Description</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-person-badge text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Trainer</h6>
                            <p class="mb-0 fw-bold">@Model.TrainerName</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-people text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Capacity</h6>
                            <p class="mb-0 fw-bold">@Model.Slots <span class="text-muted fw-normal">spots booked</span></p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-play-circle text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Start Time</h6>
                            <p class="mb-0 fw-bold">@Model.StartTime</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-stop-circle text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">End Time</h6>
                            <p class="mb-0 fw-bold">@Model.EndTime</p>
                        </div>
                    </div>
                </div>

                <div class="detail-item mb-4">
                    <div class="d-flex align-items-center">
                        <div class="icon-box me-3">
                            <i class="bi bi-hourglass-split text-primary-color fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted">Duration</h6>
                            <p class="mb-0 fw-bold">@Model.Duration</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-white border-0 p-4">
                <div class="d-flex justify-content-between gap-2">
                    <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline flex-fill">
                        <i class="bi bi-arrow-left me-1"></i>Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
