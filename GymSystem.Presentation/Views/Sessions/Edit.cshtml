@model EditSessionViewModel
@{
    ViewBag.Title = "Edit Session";
}

<header class="mb-4 mt-3">
    <h3 class="text-primary-color">Edit Session</h3>
    <p class="text-muted mb-0">Fields marked <span class="text-danger">*</span> are required.</p>
</header>

<div class="alert alert-light border d-flex align-items-center gap-3" role="alert">
    <i class="bi bi-lock fs-3 text-primary-color"></i>
    <div>
        <div class="text-muted small">Locked for this session</div>
        <div class="fw-bold fs-5">@Model.Category &middot; @Model.Capacity spots</div>
        <div class="text-muted small">
            Category and capacity can't change once the session exists - members booked against them.
        </div>
    </div>
</div>

<form method="post" asp-controller="Sessions" asp-action="Edit" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />
    @* Locked context, round-tripped so the banner survives a failed post. *@
    <input type="hidden" asp-for="Category" />
    <input type="hidden" asp-for="Capacity" />
    <input type="hidden" asp-for="Status" />

    <!-- Session Information -->
    <div class="section-header mb-3">
        <h5 class="text-primary fw-bold"><i class="bi bi-info-circle me-2"></i>Session Information</h5>
        <hr class="mt-2">
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="TrainerId">Trainer <span class="text-danger">*</span></label>
            <select asp-for="TrainerId" class="form-select">
                <option value="">-- Select Trainer --</option>
                @foreach (var trainer in Model.Trainers)
                {
                    <option value="@trainer.Id">@trainer.Name</option>
                }
            </select>
            <span asp-validation-for="TrainerId" class="text-danger"></span>
            <div class="form-text">The trainer's specialty must match @Model.Category.</div>
        </div>

        <div class="col-12">
            <label class="form-label" asp-for="Description">Description <span class="text-danger">*</span></label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
    </div>

    <!-- Date & Time -->
    <div class="section-header mb-3 mt-4">
        <h5 class="text-primary fw-bold"><i class="bi bi-calendar-event me-2"></i>Date &amp; Time</h5>
        <hr class="mt-2">
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="StartDate">Start Date &amp; Time <span class="text-danger">*</span></label>
            <input asp-for="StartDate" class="form-control" type="datetime-local"
                   asp-format="{0:yyyy-MM-ddTHH:mm}" />
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="col-12 col-md-6">
            <label class="form-label" asp-for="EndDate">End Date &amp; Time <span class="text-danger">*</span></label>
            <input asp-for="EndDate" class="form-control" type="datetime-local"
                   asp-format="{0:yyyy-MM-ddTHH:mm}" />
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>

        <div class="col-12">
            <div class="form-text">Duration is calculated automatically from the start and end times.</div>
        </div>
    </div>

    <footer class="d-flex justify-content-end gap-3 mt-4">
        <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline-secondary px-4">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>

        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-save me-2"></i>Save Changes
        </button>
    </footer>
</form>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
